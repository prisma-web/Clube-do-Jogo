# Copie para .env.local e preencha os valores.
# Sem NEXT_PUBLIC_SUPABASE_* o app roda em modo demo (dados fictícios).

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_RANKING_FORMULA=preference
# Em ambientes de teste, use false para não abrir automaticamente as notas da versão.
NEXT_PUBLIC_AUTO_OPEN_PRODUCT_UPDATE=true
# Mantém implementado, mas oculto por padrão, o modo de contemplação do fundo.
NEXT_PUBLIC_SHOW_COSMIC_BACKGROUND_VIEW=false
# Chave service-role (somente servidor). NUNCA prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- IGDB (busca de jogos) ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Só para verificação local sem credenciais da IGDB. Nunca em produção.
IGDB_OFFLINE_CATALOG=

# --- Web Push (VAPID) ---
# Gere com: npx web-push generate-vapid-keys
# A pública precisa ser idêntica nas duas variáveis abaixo.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo (mailto: ou URL https).
VAPID_SUBJECT=mailto:contato@clubedojogo.com

# --- URL do site (opcional; usada em links absolutos/OAuth) ---
# Em produção a Vercel já fornece VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
