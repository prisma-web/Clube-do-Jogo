{
  "name": "clube-do-jogo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc -p tsconfig.web.json --noEmit",
    "test:domain": "tsx --test packages/domain/src/*.test.ts",
    "test:data": "tsx --test packages/data/src/*.test.ts tests/data/*.test.ts",
    "test:api": "tsx --test tests/api/*.test.ts",
    "mobile:start": "npm run start --workspace @clube-do-jogo/mobile",
    "mobile:doctor": "npm run doctor --workspace @clube-do-jogo/mobile",
    "mobile:export": "npm run export --workspace @clube-do-jogo/mobile",
    "typecheck:mobile": "npm run typecheck --workspace @clube-do-jogo/mobile",
    "test:web": "playwright test",
    "test:mobile": "tsx --test tests/mobile/*.test.ts",
    "mobile:reuse": "node scripts/mobile-reuse.mjs",
    "perf:ranking": "node scripts/perf-ranking.mjs",
    "perf:auth": "node scripts/perf-auth.mjs",
    "test:dependency-gate": "node --test tests/release/*.test.mjs",
    "igdb:check": "tsx scripts/igdb-credentials-check.mts",
    "mobile:dependencies:gate": "node scripts/mobile-dependency-gate.mjs"
  },
  "dependencies": {
    "@clube-do-jogo/data": "0.1.0",
    "@clube-do-jogo/domain": "0.1.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-popover": "^1.1.20",
    "@radix-ui/react-tabs": "^1.1.18",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.19.1",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-virtuoso": "^4.18.11",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.27.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "expo-router": "~57.0.21",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vercel": "^58.4.4"
  },
  "overrides": {
    "postcss": "^8.5.20",
    "sharp": "^0.35.0"
  }
}
